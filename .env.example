# Ornek yapilandirma — gercek degerlerinizi .env dosyasina yazin.
# .env dosyasi versiyon kontrolune EKLENMEZ.

BOT_TOKEN=BotFather-dan-aldiginiz-token
GEMINI_API_KEY=Google-AI-Studio-anahtariniz
GEMINI_MODEL=gemini-3.6-flash

# Uzun ve rastgele olmali. Uretmek icin:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_SECRET_KEY=rastgele-uzun-bir-anahtar

# Ilk admin hesabi yalnizca BOOTSTRAP icindir; hesap olustuktan sonra
# WEB_ADMIN_PASSWORD kaldirilabilir.
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=guclu-bir-parola

# HTTPS arkasinda 1 yapin
SESSION_COOKIE_SECURE=0

# --- AI ozeti veri yonetisimi ---
# Dahili teknik notlarin AI ozetine (Gemini'ye) dahil edilip edilmeyecegi.
# Kurumsal veri politikaniz dahili teknik notlarin Gemini'ye gonderilmesine
# izin vermiyorsa false yapin. false iken notlar web panelinde teknik ekibe
# gorunmeye devam eder; yalnizca AI ozet baglamina girmez.
AI_SUMMARY_INCLUDE_INTERNAL_NOTES=true
